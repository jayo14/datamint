# ==============================================================================
# DataMint Backend Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="DataMint API"
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=4
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# PostgreSQL Database (Asyncpg connection required)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://datamint_admin:change_me_production_db_password@postgres:5432/datamint_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# Redis Cache & Celery Task Broker
# ------------------------------------------------------------------------------
# Format: redis://[:<PASSWORD>@]<HOST>:<PORT>/<DB>
REDIS_URL=redis://:change_me_production_redis_password@redis:6379/0

# ------------------------------------------------------------------------------
# Security & JWT Token Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_at_least_32_characters_random_hex_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
NONCE_EXPIRE_SECONDS=300

# ------------------------------------------------------------------------------
# Celo Blockchain & Escrow Smart Contracts
# ------------------------------------------------------------------------------
# Mainnet: https://forno.celo.org (Chain ID: 42220)
# Alfajores Testnet: https://alfajores-forno.celo-testnet.org (Chain ID: 44787)
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Deployed DatasetEscrow contract address on Celo
ESCROW_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Platform KMS / EIP-712 Voucher Signer Private Key (without 0x prefix or with 0x)
PLATFORM_SIGNER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated or JSON list of authorized frontend origins
CORS_ORIGINS=["https://datamint.ai","https://www.datamint.ai","http://localhost:3000"]
